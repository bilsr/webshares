--// ---------------------------------------------------------------
--// Protections (AntiKick / AntiAFK / AntiFling)
--// ---------------------------------------------------------------
local function enableProtections()
	-- AntiKick
	pcall(function()
		local mt = getrawmetatable(game)
		local old = mt.__namecall
		local protect = newcclosure or protect_function or function(f) return f end

		setreadonly(mt, false)
		mt.__namecall = protect(function(self, ...)
			if getnamecallmethod() == "Kick" and self == Player then
				task.wait(9e9)
				return
			end
			return old(self, ...)
		end)
		setreadonly(mt, true)
	end)

	-- AntiAFK
	Player.Idled:Connect(function()
		VirtualUser:CaptureController()
		VirtualUser:ClickButton2(Vector2.new())
	end)

	-- AntiFling
	RunService.Stepped:Connect(function()
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= Player and other.Character then
				for _, part in ipairs(other.Character:GetChildren()) do
					if part.Name == "HumanoidRootPart" then
						part.CanCollide = false
					end
				end
			end
		end

		for _, accessory in ipairs(workspace:GetChildren()) do
			if accessory:IsA("Accessory") then
				local part = accessory:FindFirstChildWhichIsA("Part")
				if part then part:Destroy() end
			end
		end
	end)

	StarterGui:SetCore("SendNotification", {
		Title = "Have Fun!",
		Text = "AntiAfk, AntiKick, AntiFling loaded!",
		Duration = 5,
	})
end

