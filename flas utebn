local function copyToClipboard(text)
	local fn = setclipboard or toclipboard or set_clipboard or (Clipboard and Clipboard.set)
	if fn then fn(text) return true end
	return false
end

--// ---------------------------------------------------------------
--// Main hub
--// ---------------------------------------------------------------
local function buildHub()
	local Fluent = loadFluent()
	local SaveManager = loadstring(game:HttpGet(SAVE_URL))()
	local InterfaceManager = loadstring(game:HttpGet(INTERFACE_URL))()

	local Window = Fluent:CreateWindow({
		Title = CONFIG.Title,
		SubTitle = CONFIG.SubTitle,
		TabWidth = 160,
		Size = UDim2.fromOffset(580, 460),
		Acrylic = true,
		Theme = "Dark",
		MinimizeKey = Enum.KeyCode.M,
	})

	local Tabs = {
		Hub      = Window:AddTab({ Title = "Hub",      Icon = "info" }),
		Main     = Window:AddTab({ Title = "Main",     Icon = "list" }),
		Settings = Window:AddTab({ Title = "Settings", Icon = "settings" }),
	}

	local function notify(title, content, duration)
		Fluent:Notify({ Title = title, Content = content, Duration = duration or 5 })
	end

	local function runHub(name, url)
		local ok, err = pcall(function()
			loadstring(game:HttpGet(url))()
		end)
		if ok then
			notify(name, "Loaded successfully.")
		else
			notify(name, "Failed to load: " .. tostring(err), 8)
		end
	end

	---------------------------------------------------------------
	-- Hub tab
	---------------------------------------------------------------
	Tabs.Hub:AddSection("Details")
	Tabs.Hub:AddParagraph({
		Title = "Version",
		Content = CONFIG.Version,
	})
	Tabs.Hub:AddParagraph({
		Title = "Role",
		Content = "Developer",
	})

	Tabs.Hub:AddSection("Theme")
	local ThemeDropdown = Tabs.Hub:AddDropdown("Theme", {
		Title = "Theme",
		Values = Fluent.Themes or { "Dark", "Darker", "Light", "Aqua", "Amethyst", "Rose" },
		Default = 1,
	})
	ThemeDropdown:OnChanged(function(value)
		Fluent:SetTheme(value)
	end)

	Tabs.Hub:AddSection("Community")
	Tabs.Hub:AddButton({
		Title = "Copy Discord Invite",
		Description = CONFIG.Discord,
		Callback = function()
			notify("Discord", copyToClipboard(CONFIG.Discord) and "Invite copied to clipboard." or "Clipboard not supported by your executor.")
		end,
	})

	---------------------------------------------------------------
	-- Main tab
	---------------------------------------------------------------
	Tabs.Main:AddSection("Hubs")
	for _, hub in ipairs(HUBS) do
		Tabs.Main:AddButton({
			Title = hub[1],
			Callback = function() runHub(hub[1], hub[2]) end,
		})
	end

	Tabs.Main:AddSection("Misc")
	for _, item in ipairs(MISC) do
		Tabs.Main:AddButton({
			Title = item[1],
			Callback = function() runHub(item[1], item[2]) end,
		})
	end

	---------------------------------------------------------------
	-- Settings tab
	---------------------------------------------------------------
	Tabs.Settings:AddSection("Info")

	local executorName = (identifyexecutor and identifyexecutor())
		or (getexecutorname and getexecutorname())
		or "Unknown"
	Tabs.Settings:AddParagraph({ Title = "Executor", Content = executorName })

	local ipParagraph = Tabs.Settings:AddParagraph({
		Title = "Network",
		Content = "Looking up...",
	})

	-- IP lookup (async so it never blocks the rest of the script)
	task.spawn(function()
		local http = request or http_request or (syn and syn.request) or (fluxus and fluxus.request)
		if not http then
			ipParagraph:SetDesc("HTTP not supported by executor")
			return
		end

		local ok, response = pcall(http, { Url = "https://ipwho.is/", Method = "GET" })
		if not ok or not response or not response.Body then
			ipParagraph:SetDesc("HTTP request failed")
			return
		end

		local decoded, data = pcall(HttpService.JSONDecode, HttpService, response.Body)
		if not decoded or type(data) ~= "table" or not data.success then
			ipParagraph:SetDesc("IP lookup failed")
			return
		end

		ipParagraph:SetDesc(table.concat({
			"IP: " .. tostring(data.ip),
			"City: " .. tostring(data.city),
			"Region: " .. tostring(data.region),
			"Country: " .. tostring(data.country),
			"VPN / Proxy: " .. ((data.connection and data.proxy) or data.proxy and "Yes" or "No"),
		}, "\n"))
	end)

	Tabs.Settings:AddSection("Script")
	Tabs.Settings:AddButton({
		Title = "Self Destruct",
		Description = "Closes the UI and unloads the hub.",
		Callback = function()
			env.BILSR_GATEWAY_RUNNING = nil
			Fluent:Destroy()
		end,
	})

	---------------------------------------------------------------
	-- Config + interface managers
	---------------------------------------------------------------
	SaveManager:SetLibrary(Fluent)
	InterfaceManager:SetLibrary(Fluent)
	SaveManager:IgnoreThemeSettings()
	SaveManager:SetIgnoreIndexes({})
	InterfaceManager:SetFolder(CONFIG.Folder)
	SaveManager:SetFolder(CONFIG.Folder .. "/configs")

	InterfaceManager:BuildInterfaceSection(Tabs.Settings)
	SaveManager:BuildConfigSection(Tabs.Settings)

	Window:SelectTab(1)
	notify(CONFIG.Title, "Loaded. Press M to toggle the UI.")
	SaveManager:LoadAutoloadConfig()
end

--// ---------------------------------------------------------------
--// Key gate
--// ---------------------------------------------------------------
local function buildKeyGate()
	local Fluent = loadFluent()

	local Window = Fluent:CreateWindow({
		Title = CONFIG.Title,
		SubTitle = "Key System",
		TabWidth = 120,
		Size = UDim2.fromOffset(460, 280),
		Acrylic = true,
		Theme = "Dark",
		MinimizeKey = Enum.KeyCode.M,
	})

	local Tab = Window:AddTab({ Title = "Key", Icon = "key" })
	Tab:AddParagraph({ Title = "Private", Content = "Enter your key to continue." })

	local entered = ""
	Tab:AddInput("KeyInput", {
		Title = "Key",
		Default = "",
		Placeholder = "Enter key...",
		Numeric = false,
		Finished = false,
		Callback = function(value) entered = value end,
	})

	Tab:AddButton({
		Title = "Submit",
		Callback = function()
			if entered == CONFIG.Key then
				Fluent:Destroy()
				task.defer(buildHub)
			else
				Fluent:Notify({ Title = "Key System", Content = "Invalid key.", Duration = 4 })
			end
		end,
	})

	Tab:AddButton({
		Title = "Copy Discord Invite",
		Callback = function() copyToClipboard(CONFIG.Discord) end,
	})

	Window:SelectTab(1)
end

--// ---------------------------------------------------------------
--// Start
--// ---------------------------------------------------------------
enableProtections()
buildKeyGate()
